# Where contact form submissions are forwarded.
# Get this from your CRM / automation platform (GoHighLevel, Zapier, Slack incoming webhook, etc.).
# When unset (e.g. in dev), submissions are logged to the server console instead.
CONTACT_WEBHOOK_URL=

# Where gym-calculator completions are forwarded (falls back to
# CONTACT_WEBHOOK_URL, then to server-console logging, when unset).
CALCULATOR_WEBHOOK_URL=

# Meta Pixel id for ad conversion tracking (Lead + CalculatorComplete events).
# When unset, no pixel is rendered and tracking calls are no-ops.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Google tracking (GA4 + Google Ads) ───────────────────────────────────────
# GA4 measurement id (looks like G-XXXXXXXXXX). Funnel events (completed_web_demo,
# demo_request, calculator_complete, started_paid_signup) fire to it via gtag;
# import them into Google Ads as conversions to optimize Search campaigns.
NEXT_PUBLIC_GA4_ID=
# Optional Google Ads tag id (looks like AW-XXXXXXXXX) for remarketing / enhanced
# conversions. Conversions themselves are best imported from GA4.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Send-to label for the "Completed Web Demo" Google Ads conversion action
# (looks like AW-11078657396/xxxxxxxx). Create the action in Google Ads
# (Tools → Conversions → New → Website), paste its label here, and the vertical
# voice-demo completion will fire as an Ads conversion (see trackCompletedWebDemo
# in src/lib/tracking.ts). No-op until set.
NEXT_PUBLIC_ADS_WEB_DEMO_SEND_TO=

# ── Live in-browser voice demo (the ungated hero demo on /ai-for-<vertical>) ──
# Base URL of the Xovera app that mints ephemeral Gemini Live tokens via its
# public /api/public/voice-demo/web-token route (CORS-open). Production:
# https://app.xovera.io — that deployment must have VOICE_DEMO_AGENT_ID and
# GEMINI_API_KEY set or the route 503s. When this is unset (or the route 503s),
# the hero demo gracefully falls back to a sample call + "Book a demo".
NEXT_PUBLIC_VOICE_API_BASE=
