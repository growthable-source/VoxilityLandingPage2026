# Where contact form submissions are forwarded.
# Get this from your CRM / automation platform (GoHighLevel, Zapier, Slack incoming webhook, etc.).
# When unset (e.g. in dev), submissions are logged to the server console instead.
CONTACT_WEBHOOK_URL=

# Where gym-calculator completions are forwarded (falls back to
# CONTACT_WEBHOOK_URL, then to server-console logging, when unset).
CALCULATOR_WEBHOOK_URL=

# Meta Pixel id for ad conversion tracking (Lead + CalculatorComplete events).
# When unset, no pixel is rendered and tracking calls are no-ops.
NEXT_PUBLIC_META_PIXEL_ID=

# ── GoHighLevel direct contact upsert (Private Integration Token) ────────────
# Campaign lead forms (/free-website, /ai-receptionist-australia) upsert the
# lead straight into the GHL subaccount so speed-to-lead automations fire
# immediately. Create the token in the subaccount: Settings → Private
# Integrations → New, with the "Edit Contacts" (contacts.write) scope.
# When unset, the upsert is skipped and logged; the webhook forwards above
# still run independently.
GHL_PIT=
# The subaccount's location id (Settings → Business Profile).
GHL_LOCATION_ID=
# Optional: id of a GHL custom field to store the Google Ads click id (gclid)
# on the contact, so booked calls can be imported back into Google Ads as
# offline conversions. Create a text custom field in GHL and paste its id.
GHL_GCLID_FIELD_ID=
# Optional: id of a GHL custom field (multi-line text) that receives the rest
# of the ad attribution (utm params, pain answer, landing page) as JSON.
GHL_ATTRIBUTION_FIELD_ID=

# ── Meta Conversions API (server-side pixel) ─────────────────────────────────
# The browser pixel loses events to ATT, Safari ITP and ad blockers. Every Meta
# event is mirrored server-side with the same event id, so Meta deduplicates the
# pair (see src/lib/metaCapi.ts). Form routes additionally send hashed email and
# phone, which matches far better than the browser can on its own.
#
# System user token with ads_management: Events Manager → your pixel → Settings
# → Conversions API → "Generate access token". Keep it server-side only — this
# is deliberately NOT a NEXT_PUBLIC_ var.
# Everything CAPI-related is a no-op until this is set.
META_CAPI_ACCESS_TOKEN=
# Optional: pixel id for the server side. Falls back to NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=
# Optional: pin the Graph API version (default v23.0). Bump if Meta deprecates it.
META_GRAPH_API_VERSION=
# Optional: while verifying in Events Manager → Test Events, paste the TESTxxxxx
# code here so events land in the test stream. MUST be unset in production.
META_TEST_EVENT_CODE=

# ── Google tracking (GA4 + Google Ads) ───────────────────────────────────────
# GA4 measurement id (looks like G-XXXXXXXXXX). Funnel events (completed_web_demo,
# demo_request, calculator_complete, started_paid_signup) fire to it via gtag;
# import them into Google Ads as conversions to optimize Search campaigns.
NEXT_PUBLIC_GA4_ID=
# Optional Google Ads tag id (looks like AW-XXXXXXXXX) for remarketing / enhanced
# conversions. Conversions themselves are best imported from GA4.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Send-to label for the "Completed Web Demo" Google Ads conversion action
# (looks like AW-11078657396/xxxxxxxx). Create the action in Google Ads
# (Tools → Conversions → New → Website), paste its label here, and the vertical
# voice-demo completion will fire as an Ads conversion (see trackCompletedWebDemo
# in src/lib/tracking.ts). No-op until set.
NEXT_PUBLIC_ADS_WEB_DEMO_SEND_TO=

# ── Live in-browser voice demo (the ungated hero demo on /ai-for-<vertical>) ──
# Base URL of the Xovera app that mints ephemeral Gemini Live tokens via its
# public /api/public/voice-demo/web-token route (CORS-open). Production:
# https://app.xovera.io — that deployment must have VOICE_DEMO_AGENT_ID and
# GEMINI_API_KEY set or the route 503s. When this is unset (or the route 503s),
# the hero demo gracefully falls back to a sample call + "Book a demo".
NEXT_PUBLIC_VOICE_API_BASE=

# ── Free build + emailed teardown funnel (/free-website) ─────────────────────
# Where free-build submissions and rebuild claims are forwarded. Falls back to
# CONTACT_WEBHOOK_URL, then to server-console logging, when unset.
FREE_BUILD_WEBHOOK_URL=

# Storage for audit records. Vercel Blob: Storage → Create → Blob, then pull the
# token with `vercel env pull`. When unset, records are written to a local
# .audit-store/ directory so the funnel runs end-to-end in dev — that fallback
# does NOT work on Vercel (read-only filesystem), so production must set this.
BLOB_READ_WRITE_TOKEN=

# Google PageSpeed Insights, mobile strategy. Free: Google Cloud console →
# enable "PageSpeed Insights API" → create an API key. Without it the speed
# finding is reported as unmeasured rather than guessed.
PAGESPEED_API_KEY=

# Google Places API (New) — the lead's rating and review count, plus three
# nearby competitors. Same Cloud project as above; enable "Places API (New)".
# A listing is only used when it is corroborated by a matching website domain
# or a near-exact name, so a missing key degrades to "we'll cover it on the call".
GOOGLE_PLACES_API_KEY=

# Gemini rewrites the audit prose (never the numbers — see src/lib/audit/narrate.ts).
# Optional: without it the deterministic template prose is used, which is
# perfectly sendable.
GEMINI_API_KEY=

# Shared secret that turns /audit/<token> into the review view with the
# "Approve & send" bar. Generate with: openssl rand -base64 32
# Fails closed — with this unset nobody can approve, and nothing sends.
AUDIT_REVIEW_SECRET=

# Where the "audit ready for review" ping goes (Slack incoming webhook, GHL
# inbound webhook, anything that accepts JSON). Logs to the server console when
# unset — which in production means nobody finds out an audit is waiting.
AUDIT_REVIEW_WEBHOOK_URL=

# ── Audit email (Resend) ─────────────────────────────────────────────────────
# resend.com → API Keys. The sending domain must have SPF, DKIM and DMARC
# records in place before the first send, or these land in spam.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. audits@xovera.io
AUDIT_FROM_EMAIL=
# Reply-to and the unsubscribe destination. Defaults to AUDIT_FROM_EMAIL.
# A monitored inbox: the Australian Spam Act requires the unsubscribe to work.
AUDIT_REPLY_TO=

# Absolute base URL used to build audit + review links in emails and webhooks.
# Must be the canonical host (see project memory: apex 308s to www).
NEXT_PUBLIC_SITE_URL=https://www.xovera.io

# Booking calendar the "Claim my free rebuild" button redirects to (a GHL
# calendar link). When unset the claim is still recorded and tagged in the CRM,
# and the lead is told we'll be in touch instead of being redirected.
NEXT_PUBLIC_BOOKING_URL=
