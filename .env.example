# Where contact form submissions are forwarded.
# Get this from your CRM / automation platform (GoHighLevel, Zapier, Slack incoming webhook, etc.).
# When unset (e.g. in dev), submissions are logged to the server console instead.
CONTACT_WEBHOOK_URL=

# Where gym-calculator completions are forwarded (falls back to
# CONTACT_WEBHOOK_URL, then to server-console logging, when unset).
CALCULATOR_WEBHOOK_URL=

# Meta Pixel id for ad conversion tracking (Lead + CalculatorComplete events).
# When unset, no pixel is rendered and tracking calls are no-ops.
NEXT_PUBLIC_META_PIXEL_ID=
